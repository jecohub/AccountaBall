<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AccountaBall.App.Views.BallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The basketball is drawn in a 100x100 space and scaled to fill the round
         window. Seams are static; the face (eyes + mouth) is reshaped per
         BallState in code-behind. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="100" Height="100" Background="Transparent">
            <!-- Ball body -->
            <Ellipse Width="100" Height="100" Fill="#E8772E" Stroke="#B45A1B" StrokeThickness="2" />

            <!-- Basketball seams -->
            <Path Stroke="#3A2410" StrokeThickness="2" Data="M 50,1 L 50,99" />
            <Path Stroke="#3A2410" StrokeThickness="2" Data="M 1,50 L 99,50" />
            <Path Stroke="#3A2410" StrokeThickness="2" Data="M 14,8 Q 40,50 14,92" />
            <Path Stroke="#3A2410" StrokeThickness="2" Data="M 86,8 Q 60,50 86,92" />

            <!-- Face -->
            <Ellipse x:Name="LeftEye" Width="9" Height="9" Fill="#1E140A"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,40,0,0" />
            <Ellipse x:Name="RightEye" Width="9" Height="9" Fill="#1E140A"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="59,40,0,0" />
            <Path x:Name="Mouth" Stroke="#1E140A" StrokeThickness="3"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Grid>
    </Viewbox>
</UserControl>
