<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AccountaBall.App.Views.RootCoordinator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AccountaBall.App.Views">
    <Grid Background="Transparent">
        <!-- Compact ball (Idle / Session / FreeBall-observing) -->
        <views:BallView x:Name="Ball" />
        <!-- Card host for every other phase -->
        <ContentControl x:Name="CardHost"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
