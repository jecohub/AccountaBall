<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AccountaBall.App.Views.RootCoordinator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AccountaBall.App.Views">
    <Grid Background="Transparent">
        <!-- Compact ball (Idle / Session / FreeBall-observing) -->
        <views:BallView x:Name="Ball" />
        <!-- Card host for every other phase -->
        <ContentControl x:Name="CardHost"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <!-- Title-bar-style close (quit) button, shown on card phases. -->
        <Button x:Name="CloseButton" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,10,0" Width="30" Height="30" Padding="0"
                FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" FontSize="12"
                ToolTipService.ToolTip="Quit AccountaBall" />
    </Grid>
</UserControl>
